---
---

<!-- Full-width Newsletter CTA Section -->
<section class="bg-gray-900 py-28 md:py-32 text-center relative overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 opacity-10">
    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 25%, rgba(255,255,255,0.1) 1px, transparent 1px), radial-gradient(circle at 75% 75%, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
  </div>

  <!-- Content -->
  <div class="container-custom relative z-10">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl md:text-5xl text-white font-bold mb-6">
        Subscribe for updates
      </h2>
      
      <p class="text-lg md:text-xl text-gray-300 mb-12 max-w-3xl mx-auto leading-relaxed">
Enjoy industry news, market updates, and educational content in your inbox.
      </p>

      <!-- Email Signup Form -->
      <div class="max-w-2xl mx-auto">
        <form class="flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <input 
              type="email" 
              placeholder="johndoe@gmail.com" 
              class="w-full px-6 py-4 text-gray-700 bg-white rounded-full border-0 outline-none placeholder-gray-400 text-lg"
              required
            />
          </div>
          
          <button 
            type="submit"
            class="px-8 py-4 bg-accent-600 text-white hover:bg-accent-700 transition-all duration-300 font-semibold text-lg whitespace-nowrap rounded-full"
          >
            Join now
          </button>
        </form>
      </div>

      <!-- Additional info -->
      <p class="text-sm text-gray-400 mt-6">
        No spam, unsubscribe anytime. We respect your privacy.
      </p>
      
      <!-- Bitcoin Crypto Video -->
      <div class="mt-16 flex justify-center">
        <div class="relative w-full max-w-2xl">
          <!-- Optimized video for smooth performance -->
          <video 
            autoplay 
            loop 
            muted 
            playsinline
            preload="auto"
            class="w-full h-auto rounded-3xl shadow-2xl"
            style="
              will-change: auto; 
              transform: translateZ(0); 
              backface-visibility: hidden;
              -webkit-backface-visibility: hidden;
            "
          >
            <source src="/bitcoin-crypto-coin.webm" type="video/webm" />
            <source src="/bitcoin-crypto-coin.mp4" type="video/mp4" />
            <!-- Fallback message for browsers that don't support video -->
            <p class="text-white text-center p-8">Your browser doesn't support video playback.</p>
          </video>
        </div>
      </div>
    </div>
  </div>
</section>
